<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Wanderly - Edit</title>
    </head>
    <body>
        <h1>Edit the existing Listing</h1>

        <form action="/listings/<%= listing._id %>?_method=PUT" method="post">
            <input type="text" name="title" value="<%= listing.title %>" />
            <br />
            <br />
            <textarea name="description"><%= listing.description %></textarea>
            <br />
            <br />
            <input type="number" name="price" value="<%=  listing.price %>" />
            <br />
            <br />
            <input type="text" name="location" value="<%=  listing.location %>" />
            <br />
            <br />
            <input type="text" name="country" value="<%=  listing.country %>" />
            <br />
            <br />
            <button type="submit">List</button>
        </form>
    </body>
</html>
