<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Wanderly - Listings</title>
    </head>

    <body>
        <form action="/listings/new" method="GET">
            <button>Create a new Listing</button>
        </form>

        <h1>All Listings</h1>
        <ul>
            <% for (let listing of allListings) { %>
                <li>
                    <a href="/listings/<%=listing._id%>"><h2><%= listing.title %></h2></a>
                </li>
            <% } %>
        </ul>
    </body>
</html>
